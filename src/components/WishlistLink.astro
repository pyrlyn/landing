---
// Target of the backend's wishlist mails: the link carries a one-time token in `?token=`, and
// the WishlistLink island sends it only on a click, so a mail scanner that opens the link changes nothing.
import { API_URL } from "../lib/config";
import { u } from "../lib/site";
import WishlistLinkIsland from "./islands/WishlistLink/WishlistLink";
interface Props { action: "confirm" | "unsubscribe" }
const { action } = Astro.props;
const copy = {
  confirm: { title: "Confirm your Pro wishlist place.", text: "We mail you once, when paid plans for this tool open.", button: "Confirm" },
  unsubscribe: { title: "Leave the Pro wishlist.", text: "Your address is deleted from this tool's wishlist.", button: "Unsubscribe" },
}[action];
---
<section class="err" aria-labelledby="wl-title" data-wishlist-link={action}>
  <h1 id="wl-title">{copy.title}</h1>
  <p class="err__text">{copy.text}</p>
  <WishlistLinkIsland client:load api={API_URL || undefined} action={action} label={copy.button} />
  <a href={u("/")}>Back to home</a>
</section>
