---
// Home hero: 3D ring carousel of product cards (faux-3D, CSS preserve-3d).
// Cards are real links; one glass hotspot per card opens a real feature from that tool's README.
// No JS / <768px: a plain grid. Reduced motion: no auto-rotate, instant turns.
// Behaviour, counter and controls: the RingCarousel island; the cards stay static Astro markup (its children).
import Icon from "./Icon.astro";
import RingIsland from "./islands/RingCarousel/RingCarousel";
import Picture from "./Picture.astro";
import { u } from "../lib/site";
import { proFor, hasPro, versionLabel } from "../lib/catalog";
import type { CollectionEntry } from "astro:content";
interface Hotspot { tool: string; label: string; text: string }
interface Props { tools: CollectionEntry<"projects">[]; hotspots: Hotspot[] }
const { tools, hotspots } = Astro.props;
const n = tools.length;
---
<RingIsland client:visible titles={tools.map((t) => t.data.title)}>
    <ul class="ring__track" data-ring-track data-hotspots>
      {tools.map((t, i) => {
        const hs = hotspots.find((h) => h.tool === t.id);
        return (
          <li class="ring__item" style={`--i:${i};--card-accent:${t.data.accent}`} data-ring-item aria-roledescription="slide" aria-label={`${i + 1} of ${n}: ${t.data.title}`}>
            <div class="ring__face">
              <a class="ring__card glass glass--thick" href={u(`/${t.id}/`)} draggable="false">
                <Picture class="ring__art" dir={t.id} name="prop" widths={[400]} sizes="240px" w={400} h={400} />
                <span class="ring__meta"><span class="badge badge--version" style={`--accent:${t.data.accent}`}>{versionLabel(t)}</span></span>
                <strong class="ring__title">{t.data.title}<span>.</span></strong>
                <span class="ring__tag">{t.data.tagline}</span>
                <span class="ring__foot"><span>{hasPro(t) ? <>Free · Pro <span data-pro-price={t.id}>{proFor(t).price}</span>*</> : "Free"}</span><Icon name="arrow" size={16} /></span>
              </a>
              {hs && (
                <div class="hotspot ring__hs">
                  <button class="hotspot__dot" type="button" aria-expanded="false" aria-controls={`hs-${t.id}`} style={`--card-accent:${t.data.accent}`}>
                    <span class="sr-only">{hs.label}: show a feature</span>
                  </button>
                  <div class="hotspot__tip glass glass--thick" id={`hs-${t.id}`} role="note" hidden style={`--card-accent:${t.data.accent}`}>
                    <p class="hotspot__kicker">{hs.label}</p>
                    <p>{hs.text}</p>
                  </div>
                </div>
              )}
            </div>
          </li>
        );
      })}
    </ul>
</RingIsland>
