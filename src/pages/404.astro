---
// Not-found page. nginx serves dist/404.html for any missing path (error_page 404).
import Base from "../layouts/Base.astro";
import { u } from "../lib/site";
---
<Base title="Page not found | Pyrlyn" description="This page doesn't exist. Browse Pyrlyn's developer tools: Rtok, Ketch, Cox, Runa, Swarfr, Stator and more." theme="home" noindex>
  <section class="err" aria-labelledby="err-title">
    <p class="err__code" aria-hidden="true">404</p>
    <h1 id="err-title">Page not found.</h1>
    <p class="err__text">This page doesn't exist or has moved.</p>
    <a class="btn btn--primary btn--lg" href={u("/")}>Back to home</a>
  </section>
</Base>
