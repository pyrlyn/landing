# Site config read at build time (src/lib/config.ts). Copy to .env.local and fill in; never commit real values.
# Algolia: Application ID and a SEARCH-ONLY key (public by design). Never put the Admin key here.
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=
ALGOLIA_INDEX=pyrlyn
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty = gtag is not loaded.
GA_MEASUREMENT_ID=
