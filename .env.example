# Site config read at build time (src/lib/config.ts). Copy to .env.local and fill in; never commit real values.
# Google Analytics 4 measurement ID (default G-61CRNDXXYK; "off" disables gtag).
GA_MEASUREMENT_ID=G-61CRNDXXYK
# PostHog project API key (phc_..., public) and host; empty key disables PostHog.
POSTHOG_KEY=phc_oirHFL4DjcX7uyo2fmEaiXB3KA25Qyv8HoAbVEv32xkH
POSTHOG_HOST=https://eu.i.posthog.com
# Backend GraphQL endpoint (https://…/graphql, public). Set: Pro prices come from it at build time and
# again in the browser, and the Pro wishlist form opens. Empty: placeholder prices, disabled button.
API_URL=
