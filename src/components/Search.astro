---
// Header search (design: Мия). Styles in src/styles/search.css, behaviour in src/scripts/search.ts,
// data source in src/scripts/search-provider.ts (stub until a backend is wired).
---
<div class="search" data-open="false" data-search>
  <button class="search__btn" type="button" aria-label="Search" aria-expanded="false" aria-controls="search-input" title="Search (/ or ⌘K)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
  <input id="search-input" class="search__input" type="search" role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" aria-label="Search tools and docs" autocomplete="off" placeholder="Search tools and docs" tabindex="-1" />
  <kbd class="search__kbd">Esc</kbd>
  <button class="search__cancel" type="button" tabindex="-1" aria-label="Close search">Cancel</button>
  <div id="search-results" class="search__panel" role="listbox" aria-label="Search results" hidden></div>
</div>
