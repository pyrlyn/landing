---
// Glass (v1) prototype: heavy glassmorphism over a graphite wallpaper. noindex, excluded from the sitemap.
import Base from "../layouts/Base.astro";

const features = [
  { icon: "⌘", title: "Keyboard-first", text: "Every action is two keystrokes away. No menus to hunt through." },
  { icon: "↻", title: "Instant sync", text: "Changes land everywhere in under 50 ms, even offline." },
  { icon: "◎", title: "Focused views", text: "See only what matters this week. The rest waits patiently." },
  { icon: "⇄", title: "Integrations", text: "Git, chat and calendar, connected without glue code." },
  { icon: "▤", title: "Clear reports", text: "Progress you can read in ten seconds, not ten slides." },
  { icon: "⛨", title: "Private by default", text: "SSO, audit logs and regional data residency included." },
];
const plans = [
  { name: "Starter", price: "$0", note: "For individuals", items: ["Unlimited issues", "2 projects", "Community support"], cta: "Choose Starter" },
  { name: "Team", price: "$8", note: "per seat / month", items: ["Unlimited projects", "Timelines & reports", "Priority support"], cta: "Choose Team", featured: true },
  { name: "Enterprise", price: "Custom", note: "For organizations", items: ["SSO & SCIM", "Audit logs", "Dedicated manager"], cta: "Contact sales" },
];
---
<Base title="Glass | Pyrlyn" description="A heavy-glass landing prototype." theme="home" noindex>
  <div class="gl">
    <div class="gl__wall" aria-hidden="true"></div>
    <section class="gl__hero" aria-labelledby="gl-title">
      <span class="gl__pill gl__glass">New · Shared timelines are here</span>
      <h1 id="gl-title">Plan the work.<br />Quietly ship it.</h1>
      <p>A calm workspace for teams who would rather build than manage tools. Fast, keyboard-first, and out of your way.</p>
      <div class="gl__actions">
        <a class="gl__btn" href="#gl-pricing">Start free</a>
        <a class="gl__btn gl__btn--ghost" href="#gl-features">See how it works</a>
      </div>
    </section>

    <section id="gl-features" class="gl__grid" aria-label="Features">
      {features.map((f) => (
        <article class="gl__card gl__glass">
          <div class="gl__ico" aria-hidden="true">{f.icon}</div>
          <h2>{f.title}</h2>
          <p>{f.text}</p>
        </article>
      ))}
    </section>

    <section id="gl-pricing" aria-labelledby="gl-pricing-title">
      <h2 id="gl-pricing-title" class="gl__h2">Simple pricing</h2>
      <p class="gl__sub">Start free. Upgrade when your team does.</p>
      <div class="gl__pricing">
        {plans.map((p) => (
          <article class:list={["gl__plan gl__glass", { "gl__plan--featured": p.featured }]}>
            <h3>{p.name}</h3>
            <div class="gl__price">{p.price}</div>
            <span class="gl__muted">{p.note}</span>
            <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
            <a class:list={["gl__btn", { "gl__btn--ghost": !p.featured }]} href="#gl-pricing">{p.cta}</a>
          </article>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .gl {
    /* Page-local palette: graphite stays dark in both site themes. */
    --gl-blur: 40px;
    --gl-surface: rgba(28, 30, 34, 0.55);
    --gl-surface-strong: rgba(40, 43, 48, 0.7);
    --gl-opaque: #1c1e22;
    --gl-line: rgba(255, 255, 255, 0.1);
    --gl-hi: rgba(255, 255, 255, 0.08);
    --gl-fg: #f2f3f5;
    --gl-muted: #a9adb5; /* 8:1 on the opaque surface */
    --gl-cta: #e8e9eb;
    position: relative;
    isolation: isolate;
    max-width: var(--container, 1200px);
    margin: 0 auto;
    padding: 0 var(--s-5);
    color: var(--gl-fg);
    font-family: var(--font-sans);
  }
  .gl__wall {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.015) 0 1px, transparent 1px 3px),
      radial-gradient(60vw 50vh at 15% 20%, #3a3f47 0, transparent 60%),
      radial-gradient(50vw 50vh at 85% 70%, #2b4038 0, transparent 60%),
      radial-gradient(40vw 40vh at 60% 10%, #4a4136 0, transparent 60%),
      #121316;
  }
  .gl__glass {
    background: var(--gl-surface);
    -webkit-backdrop-filter: blur(var(--gl-blur)) saturate(140%);
    backdrop-filter: blur(var(--gl-blur)) saturate(140%);
    border: 1px solid var(--gl-line);
    border-radius: var(--r-lg);
    box-shadow: inset 0 1px 0 var(--gl-hi), var(--shadow-2, var(--e-2));
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .gl__glass { background: var(--gl-opaque); }
  }
  @media (prefers-reduced-transparency: reduce) {
    .gl__glass { background: var(--gl-opaque); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
  .gl a:focus-visible {
    outline: 2px solid var(--gl-fg);
    outline-offset: 3px;
    border-radius: var(--r-sm);
  }
  .gl__btn {
    display: inline-block;
    padding: var(--s-3) var(--s-5);
    border-radius: var(--r-full);
    font-size: var(--fs-sm);
    font-weight: 500;
    background: var(--gl-cta);
    color: #111;
    text-decoration: none;
    transition: transform 0.2s var(--ease);
  }
  .gl__btn:hover { transform: translateY(-1px); }
  .gl__btn--ghost { background: rgba(255, 255, 255, 0.06); color: var(--gl-fg); border: 1px solid var(--gl-line); }
  .gl__hero { text-align: center; padding: var(--s-10) 0 var(--s-8); }
  .gl__hero h1 {
    font-size: var(--fs-display);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 600;
    margin: var(--s-4) 0;
    color: var(--gl-fg);
  }
  .gl__hero p { color: var(--gl-muted); font-size: var(--fs-lg); max-width: 560px; margin: 0 auto var(--s-6); }
  .gl__actions { display: flex; gap: var(--s-3); justify-content: center; flex-wrap: wrap; }
  .gl__pill { display: inline-block; font-size: var(--fs-sm); padding: var(--s-1) var(--s-3); color: var(--gl-muted); border-radius: var(--r-full); }
  .gl__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-4); margin: var(--s-7) 0 var(--s-9); }
  .gl__card { padding: var(--s-6) var(--s-5); }
  .gl__card h2 { margin: var(--s-3) 0 var(--s-1); font-size: var(--fs-lg); letter-spacing: -0.01em; color: var(--gl-fg); }
  .gl__card p, .gl__muted { margin: 0; color: var(--gl-muted); font-size: var(--fs-sm); }
  .gl__ico {
    width: 36px; height: 36px; display: grid; place-items: center;
    border-radius: var(--r-md); border: 1px solid var(--gl-line); background: rgba(255, 255, 255, 0.05);
  }
  .gl__h2 { font-size: var(--fs-2xl); letter-spacing: -0.035em; text-align: center; margin: 0 0 var(--s-2); font-weight: 600; color: var(--gl-fg); }
  .gl__sub { text-align: center; color: var(--gl-muted); margin: 0 0 var(--s-7); }
  .gl__pricing { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-4); margin-bottom: var(--s-9); }
  .gl__plan { padding: var(--s-6); }
  .gl__plan h3 { margin: 0; font-size: var(--fs-md); color: var(--gl-fg); }
  .gl__plan--featured { --gl-surface: var(--gl-surface-strong); outline: 1px solid rgba(255, 255, 255, 0.22); }
  .gl__price { font-size: 2.5rem; letter-spacing: -0.04em; font-weight: 600; margin: var(--s-2) 0; }
  .gl__plan ul { padding: 0; list-style: none; color: var(--gl-muted); font-size: var(--fs-sm); margin: var(--s-5) 0 var(--s-6); }
  .gl__plan li { padding: var(--s-2) 0; border-top: 1px solid var(--gl-line); }
  @media (max-width: 800px) {
    .gl__grid, .gl__pricing { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gl__btn { transition: none; }
    .gl__btn:hover { transform: none; }
  }
</style>
