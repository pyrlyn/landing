{
  "name": "landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pyrlyn — a storefront for AI developer tools (rtok, cox, ketch), built with Astro.",
  "scripts": {
    "brand": "pyrlyn-brand-copy public pyrlyn --favicon listepo/listepo-favicon.svg",
    "predev": "npm run brand && npm run font",
    "font": "node scripts/fetch-font.mjs",
    "dev": "astro dev",
    "prebuild": "npm run brand && npm run font",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "check:docs": "node scripts/check-docs.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@pyrlyn/brand": "github:pyrlyn/brand#v0.5.0",
    "@pyrlyn/sdk": "file:vendor/pyrlyn-sdk-0.1.0.tgz",
    "astro": "^7.3.8",
    "marked": "^16.0.0",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
